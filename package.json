{
  "name": "aegis12-gateway",
  "version": "2.0.0",
  "description": "High-Veracity Sovereign Compliance Gateway for Autonomous AI Agents on Solana. Hardware-attested policy enforcement with Post-Quantum (ML-DSA) resilience.",
  "main": "dist/index.js",
  "scripts": {
    "demo:agent": "tsx scripts/demo_agent.ts",
    "check-types": "tsc --noEmit",
    "test": "npm run check-types && vitest run",
    "test:e2e": "npx playwright test --config playwright.config.ts",
    "test:e2e:prod": "TEST_API_URL=$TEST_API_URL npx playwright test --config playwright.config.ts",
    "build": "tsc && cp -r src/infrastructure/idl dist/infrastructure/idl",
    "start": "tsx src/server.ts",
    "start:cvm": "tsx src/phala_cvm_server.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "pre-commit": "(npm audit --audit-level=high || echo 'Known transitive vulns in upstream crypto deps - non-blocking') && lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "npm run test --passWithNoTests"
    ]
  },
  "keywords": [
    "solana",
    "ai-agents",
    "compliance",
    "tee",
    "post-quantum",
    "eu-ai-act"
  ],
  "author": "Berlin AI Labs",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "sinon": "^21.1.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@noble/post-quantum": "^0.6.1",
    "@solana/spl-memo": "^0.2.5",
    "@solana/web3.js": "^1.98.4",
    "@sqds/multisig": "^2.1.4",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "ethers": "^5.8.0",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "tweetnacl": "^1.0.3",
    "undici": "^8.1.0",
    "x402-solana": "^2.0.4"
  }
}
