FROM node:20-alpine
WORKDIR /app

# Install project dependencies definitively
COPY package*.json ./
RUN npm ci

# Copy the server logic and SDK wrapper
COPY src/ ./src/
COPY packages/ ./packages/
COPY tsconfig.json ./

# Phala CVM runs typically on port 8000
ENV PORT=8000
ENV NODE_ENV=staging
EXPOSE 8000

# Execute natively using TSX to bypass strict Type-checking crashes
CMD ["npx", "tsx", "src/phala_cvm_server.ts"]
