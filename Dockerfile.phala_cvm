# Build Stage
FROM node:18-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY tsconfig*.json ./

# Install project dependencies
RUN npm install

# Copy source logic
COPY src/ ./src/
COPY packages/ ./packages/

# We run typescript compiler directly natively to transpile the CVM server
RUN npx tsc src/phala_cvm_server.ts --esModuleInterop --skipLibCheck

# Production Stage
FROM node:18-alpine
WORKDIR /app

# Copy the transpiled logic and dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY --from=builder /app/packages ./packages

# Phala CVM runs typically on port 8000
ENV PORT=8000
EXPOSE 8000

# Execute the native Hardware Enclave server
CMD ["node", "src/phala_cvm_server.js"]
