# STAGE 1: Build the RISC Zero ZK Prover (Rust)
FROM rust:bookworm AS prover-builder
WORKDIR /build

# Install dependencies for RISC Zero
RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Use rzup to install the RISC Zero toolchain (official method)
RUN curl -L https://risczero.com/install | bash
ENV PATH="/root/.risc0/bin:/root/.cargo/bin:${PATH}"
RUN rzup install rust
RUN rzup install cargo-risczero

# Note: We don't run `cargo risczero install` here as it might be too heavy for some CI environments
# but the host build will trigger guest compilation if needed.

COPY aegis-zk-prover/ /build/aegis-zk-prover/
WORKDIR /build/aegis-zk-prover

# Build the host binary in release mode
# This will also compile the guest methods.
RUN cargo build --release

# STAGE 2: Build the Node.js Application
FROM node:20-bookworm AS app-builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG GIT_COMMIT_SHA
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}

# Build the TypeScript source to dist/
RUN npm run build

# STAGE 3: Final Production Image
FROM node:20-bookworm-slim
WORKDIR /app

# Install runtime dependencies (e.g., for child_process execution of the prover)
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled application
COPY --from=app-builder /app/dist ./dist
COPY --from=app-builder /app/node_modules ./node_modules
COPY --from=app-builder /app/package.json ./

# Copy the ZK Prover binary to the standardized production path
RUN mkdir -p /app/bin
COPY --from=prover-builder /build/aegis-zk-prover/target/release/host /app/bin/aegis-zk-prover
RUN chmod +x /app/bin/aegis-zk-prover

# Copy RISC Zero IPC prover dependencies (r0vm)
COPY --from=prover-builder /root/.risc0 /root/.risc0
COPY --from=prover-builder /root/.cargo /root/.cargo
ENV PATH="/root/.cargo/bin:/root/.risc0/bin:${PATH}"

# Create data directory for WAL Engine state persistence and lock files
RUN mkdir -p /var/data

# Environment Configuration
ENV PORT=8000
ENV NODE_ENV=production
ENV TEE_ENV=phala
ENV PHALA_CVM_ENVIRONMENT=1
EXPOSE 8000

# Entrypoint script to calculate hash and start the enclave
RUN echo '#!/bin/sh\n\
export AEGIS_ZK_PROVER_HASH=$(sha256sum /app/bin/aegis-zk-prover | cut -d" " -f1)\n\
echo "[Aegis-12] Calculated Prover Hash: $AEGIS_ZK_PROVER_HASH"\n\
\n\
# Wait for dStack sidecar socket if in TEE mode\n\
if [ "$TEE_ENV" = "phala" ]; then\n\
    echo "[Aegis-12] Waiting for /var/run/dstack.sock..." \n\
    for i in $(seq 1 30); do\n\
        if [ -S /var/run/dstack.sock ]; then\n\
            echo "[Aegis-12] Hardware socket found."\n\
            break\n\
        fi\n\
        sleep 2\n\
    done\n\
fi\n\
\n\
# Start the Node.js application with explicit memory limits for 2GB CVM\n\
exec node --max-old-space-size=1536 dist/phala_cvm_server.js' > /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
