{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --prefix nextjs-demo && npm run build --prefix nextjs-demo"
  },
  "deploy": {
    "startCommand": "HOSTNAME=0.0.0.0 PORT=3000 npm start --prefix nextjs-demo",
    "restartPolicyType": "ON_FAILURE"
  }
}
